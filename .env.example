# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# App
NEXT_PUBLIC_APP_URL=
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend (email transazionali)
RESEND_API_KEY=
# Cloudflare R2 (registrazioni chiamate)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Inngest (elaborazione asincrona webhook)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Telnyx (numerazione)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_MOCK_MODE=false
# Vapi (motore conversazionale AI)
VAPI_API_KEY=
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Provider voce e trascrizione (secret server-side)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# Webhook provider AI
AI_WEBHOOK_SECRET=
VAPI_WEBHOOK_SIGNING_SECRET=
WHATSAPP_APP_SECRET=
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# Solo sviluppo/test locale; in produzione usare HMAC provider-specifico.
WEBHOOK_ALLOW_SHARED_SECRET_FALLBACK=false
# Sentry — DSN pubblico e token solo server/CI
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Langfuse Cloud — server-side only
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AI providers — server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_MATCH_THRESHOLD=0.35
RAG_INPUT_COST_USD_PER_1K=0.00015
RAG_OUTPUT_COST_USD_PER_1K=0.0006
# Knowledge ingestion: Firecrawl e Unstructured sono opzionali; senza chiavi si usano fallback limitati.
FIRECRAWL_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general
# Multi-tenant observability fallback
OBSERVABILITY_DEFAULT_ORG_ID=default
# Voice stack
VAPI_SERVER_URL=https://prontoai24.it/api/webhooks/vapi
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
NEXT_PUBLIC_WEBCHAT_PUBLIC_KEY=
